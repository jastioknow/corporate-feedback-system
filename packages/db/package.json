{
  "name": "@corporate/db",
  "version": "1.0.0",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "type-check": "tsc --noEmit",
    "lint": "nx eslint:lint --max-warnings 0",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/src/index.js --target=es2023 --minify",
    "build": "pnpm run build:types && pnpm run build:js"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.16.0",
    "esbuild": "^0.27.2",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.2.0",
    "bcrypt": "^6.0.0",
    "pg": "^8.17.2"
  }
}
