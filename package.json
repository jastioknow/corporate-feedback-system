{
  "name": "corporate-feedback-system",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack internal feedback management system. Built with Next.js, NestJS, and Prisma. Features include Role-Based Access Control (RBAC), Automated CI/CD pipelines via GitHub Actions, and E2E testing with Jest",
  "scripts": {
    "prisma:seed": "pnpm --filter @corporate/db exec prisma db seed",
    "prisma:generate": "pnpm --filter @corporate/db gen",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jastioknow/corporate-feedback-system.git"
  },
  "author": "jastioknow",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jastioknow/corporate-feedback-system/issues"
  },
  "homepage": "https://github.com/jastioknow/corporate-feedback-system#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.51.0"
  }
}
